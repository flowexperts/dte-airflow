# Distroless production image for the DTE backend.
#
# Build:  docker build -f Dockerfile.prod -t dte-backend:prod ./backend
# Run:    docker run -e DATABASE_URL=... -p 8001:8001 dte-backend:prod
#
# Design decisions:
# - Builder: python:3.12-slim-bookworm (Debian 12, GLIBC 2.36) — the version suffix
#   MUST match the distroless base. python:3.12-slim now tracks Debian 13 (GLIBC 2.41)
#   which breaks libpython3.12.so.1.0 in the distroless base-debian12 (GLIBC 2.36).
# - Runtime: gcr.io/distroless/base-debian12:nonroot — no shell, no apt, no Python
#   preinstalled; we bring the full CPython 3.12 interpreter from the builder.
#   We cannot use gcr.io/distroless/python3-debian12 because it ships Python 3.11
#   (Debian 12 system package) while this project requires Python >=3.12.
#   gcr.io/distroless/base-debian12 ships glibc (2.36) + openssl + libc and
#   nothing else, making it safe to layer our own Python runtime on top.
# - Entrypoint: dte/docker/entrypoint.py (pure Python; replaces
#   docker/backend-entrypoint.sh which needs /bin/sh).
# - Alembic: invoked via `python -c "from alembic.config import main; main(...)"`
#   in the entrypoint — distroless PATH doesn't resolve /usr/local/bin shebangs.
# - psycopg2-binary bundles libpq + kerberos + sasl statically, so no extra
#   shared-library copies are needed in the runtime stage.

# ── Builder ──────────────────────────────────────────────────────────────────
FROM python:3.12-slim-bookworm AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY dte ./dte
COPY alembic ./alembic
COPY alembic.ini ./

# Install into the system site-packages so the distroless stage can copy a
# single predictable path (/usr/local/lib/python3.12).
RUN pip install --no-cache-dir -e . && pip install --no-cache-dir "psycopg2-binary>=2.9"

# Collect system libs that distroless/base-debian12 doesn't include but
# Python 3.12 extensions require.  We copy them to /runtime-libs/ so the
# runtime stage can COPY from a single architecture-agnostic path.
#
# Resolved library list (audited via ldd on extension .so files):
#   libz.so.1      — zlib, binascii, many high-level packages
#   libffi.so.8    — ctypes → cffi → cryptography → many packages
#   libbz2.so.1.0  — bz2 module
#   liblzma.so.5   — lzma module
#   libuuid.so.1   — uuid module
#   libgcc_s.so.1  — Rust/C++ extensions (pydantic-core, asyncpg)
#   libstdc++.so.6 — greenlet (SQLAlchemy uses it for sync context)
RUN mkdir /runtime-libs && \
    for lib in libz.so.1 libffi.so.8 libbz2.so.1.0 liblzma.so.5 libuuid.so.1 libgcc_s.so.1 libstdc++.so.6; do \
        src=$(find /lib /usr/lib -name "$lib" -not -type d 2>/dev/null | head -1); \
        [ -n "$src" ] && cp "$src" /runtime-libs/ || echo "WARNING: $lib not found"; \
    done && ls /runtime-libs/

# Pre-own everything so the distroless nonroot uid (65532) can read it.
RUN chown -R 65532:65532 /app /usr/local/lib/python3.12 /usr/local/bin /runtime-libs

# ── Runtime (distroless) ──────────────────────────────────────────────────────
# gcr.io/distroless/base-debian12:nonroot
#   - glibc + openssl + libc — minimal Debian 12 base
#   - NO Python interpreter — we bring Python 3.12 from the builder
#   - uid/gid 65532 ("nonroot")
#   - no shell, no apt, no curl — minimal attack surface
FROM gcr.io/distroless/base-debian12:nonroot AS runtime

# Bring the CPython 3.12 interpreter binary itself.
COPY --from=builder /usr/local/bin/python3.12 /usr/local/bin/python3.12

# libpython3.12.so.1.0 is required by the interpreter binary.
# libc.so.6, libm.so.6, libssl.so.3, libcrypto.so.3 come from the distroless base.
# Remaining required libs were collected into /runtime-libs/ during the build
# stage (architecture-agnostic path avoids hardcoding aarch64/x86_64 suffixes).
COPY --from=builder /usr/local/lib/libpython3.12.so.1.0 /usr/local/lib/libpython3.12.so.1.0
COPY --from=builder /runtime-libs/ /lib/

# Python standard library + installed packages from builder.
COPY --from=builder /usr/local/lib/python3.12 /usr/local/lib/python3.12

# Console scripts (uvicorn, alembic, …) — kept for PATH-based invocations
# outside the container (e.g. docker exec debugging). The entrypoint bypasses
# them via sys.executable to avoid the broken-shebang issue in distroless.
COPY --from=builder /usr/local/bin/uvicorn /usr/local/bin/uvicorn
COPY --from=builder /usr/local/bin/alembic /usr/local/bin/alembic

# Application source + alembic migrations.
COPY --from=builder --chown=65532:65532 /app /app

# psycopg2-binary is used as a wheel — bundles its own libpq + krb5 + sasl
# statically. asyncpg (runtime driver) is Cython + pure Python, no system libs.
# So no libpq closure is needed on distroless.

WORKDIR /app

# distroless nonroot uid
USER nonroot

EXPOSE 8001

# HEALTHCHECK uses Python's urllib — no curl/wget in distroless.
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=5 \
    CMD ["/usr/local/bin/python3.12", "-c", \
         "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8001/healthz', timeout=2).status==200 else 1)"]

# Shell-free entrypoint: runs alembic then exec-s uvicorn.
# Use the full path to bypass distroless PATH resolution issues.
ENTRYPOINT ["/usr/local/bin/python3.12", "-m", "dte.docker.entrypoint"]
