# DTE inside Airflow 3.3 (plans 065, 067). Build context: repo root.
FROM node:22-alpine AS ui
RUN corepack enable
WORKDIR /app
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend ./
RUN pnpm build

FROM apache/airflow:3.3.2-python3.12 AS base
ARG AIRFLOW_CONSTRAINTS=https://raw.githubusercontent.com/apache/airflow/constraints-3.3.2/constraints-3.12.txt
USER root
# Owned by airflow so fresh named volumes mounted here are writable.
RUN mkdir -p /opt/airflow/state /var/lib/dte/artifacts /var/lib/dte/pipelines && chown -R airflow:root /opt/airflow/state /var/lib/dte
# Microsoft ODBC Driver 18: the one driver SQL Server sources and destinations
# share (pyodbc, via the `[mssql]` extra). No-op if the base image ships it.
RUN if ! odbcinst -q -d -n "ODBC Driver 18 for SQL Server" >/dev/null 2>&1; then \
      curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg && \
      . /etc/os-release && echo "deb [arch=amd64,arm64 signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/${VERSION_ID}/prod ${VERSION_CODENAME} main" > /etc/apt/sources.list.d/mssql-release.list && \
      apt-get update && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 unixodbc && \
      rm -rf /var/lib/apt/lists/*; \
    fi
USER airflow
COPY --chown=airflow:root backend /opt/dte/backend
# Airflow's constraints, unmodified: DTE follows Airflow's pins (plan 073).
# amazon/mongo/mssql add the providers the stock image lacks, so every DTE
# connection kind is available here (plan 074).
RUN curl -fsSLo /tmp/constraints.txt ${AIRFLOW_CONSTRAINTS} && \
    pip install --no-cache-dir --constraint /tmp/constraints.txt \
    -e "/opt/dte/backend[airflow,unstructured,models,mysql-writer,mssql,amazon,mongo,kafka]"

# UI plugin bundle (plan 066); served at /dte/ui, loaded by Airflow as a react_app.
FROM base AS final
COPY --from=ui --chown=airflow:root /app/dist /opt/dte/backend/ui
