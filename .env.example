# Run scripts/bootstrap.sh to generate .env with fresh values instead of
# copying this by hand. docker compose refuses to start while any is unset.

# Encrypts Airflow Connections (and so every DTE credential) at rest.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Signs Airflow API / session tokens.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AIRFLOW_JWT_SECRET=

# Password for the `admin` login (Airflow simple auth manager).
DTE_ADMIN_PASSWORD=

# Optional: LLM keys for extract / structure steps.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
