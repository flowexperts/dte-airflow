{
  "name": "dte-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "sh -c 'vitepress dev docs-vp --port 3101 & trap \"kill $!\" EXIT INT TERM; next dev \"$@\"' sh",
    "build": "next build && vitepress build docs-vp",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "docs:dev": "vitepress dev docs-vp --port 3101"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "marked": "^18.1.2",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.62.1",
    "prettier": "^3.3.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.14.0",
    "vue": "3.5.44"
  }
}
