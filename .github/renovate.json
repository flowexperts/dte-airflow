{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "schedule": ["before 6am on Saturday", "before 6am on Sunday"],
  "automerge": false,
  "packageRules": [
    {
      "description": "Group Python minor-version bumps",
      "matchManagers": ["pip_requirements", "pyproject", "uv"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python-minor-patch",
      "labels": ["dependencies", "python"]
    },
    {
      "description": "Python major bumps are separate PRs — do not group",
      "matchManagers": ["pip_requirements", "pyproject", "uv"],
      "matchUpdateTypes": ["major"],
      "groupName": "python-major",
      "labels": ["dependencies", "python", "major"]
    },
    {
      "description": "Group pnpm / Node.js minor and patch updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "pnpm-minor-patch",
      "labels": ["dependencies", "frontend"]
    },
    {
      "description": "npm major bumps are separate PRs",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "groupName": "pnpm-major",
      "labels": ["dependencies", "frontend", "major"]
    },
    {
      "description": "Group GitHub Actions minor + patch updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "github-actions",
      "labels": ["dependencies", "ci"]
    },
    {
      "description": "Security updates get high priority label",
      "matchDepTypes": ["dependencies", "devDependencies"],
      "isVulnerabilityAlert": true,
      "labels": ["security", "dependencies"],
      "prPriority": 10,
      "automerge": false
    },
    {
      "description": "Keep cryptography <43 — 43+ switched to Rust bindings whose wheels SIGILL on Docker Desktop arm64 (Apple Silicon emulation). Disable major bumps.",
      "matchPackageNames": ["cryptography"],
      "allowedVersions": "<43",
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
